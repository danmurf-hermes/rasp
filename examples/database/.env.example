# Copy to .env and fill in; the Compose example reads these.
# SQLite example (no credentials needed):
RASP_DB_CONNECTION=data/guestbook.db
# Postgres example:
# RASP_DB_CONNECTION=Provider=SQLOLEDB;Server=db;Database=guestbook;Uid=guestbook;Pwd=secret
# ASP_DB_USER=guestbook
# ASP_DB_PASSWORD=secret
