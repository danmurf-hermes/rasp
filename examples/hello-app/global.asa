<SCRIPT RUNAT=Server LANGUAGE="VBScript">
Sub Application_OnStart
  Application("app_booted") = "yes"
End Sub
</SCRIPT>

<SCRIPT RUNAT=Server LANGUAGE="VBScript">
Sub Session_OnStart
  Session("page_views") = 0
End Sub
</SCRIPT>

<SCRIPT RUNAT=Server LANGUAGE="VBScript">
Sub Session_OnEnd
  ' Fired when the session is abandoned or idles out; the dying
  ' session's values are readable here (IIS behaviour).
  Application("last_ended_views") = Session("page_views")
End Sub
</SCRIPT>